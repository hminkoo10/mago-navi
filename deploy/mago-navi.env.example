# /etc/mago-navi.env (root 0600) — 마고 과목내비 웹 서버 설정. systemd(mago-navi.service)가 읽음
# 바꾼 뒤: sudo systemctl restart mago-navi

# 마고에듀 통합 클라우드 (로그인·학생 명단·학원 AI)
MAGO_CLOUD_URL=https://mago.milky.kr
MAGO_APP_ID=mago-navi
# 통합 클라우드 > 프로그램 관리 > 마고 과목내비 > 앱 비밀값 만들기 (한 번만 보여 줌)
MAGO_APP_SECRET=

# 서버에 저장하는 키 암호화용 비밀값 (16자 이상, 예: openssl rand -hex 32). 바꾸면 저장된 값을 못 풂
AI_KEY_SECRET=

# 1이면 학원 AI도 내 키도 없을 때 서버 AI(AI_BASE_URL 등)를 씀. 기본 끔 (비용)
MAGO_SERVER_AI_FALLBACK=0

# 나이스 교육정보 개방 포털 인증키. 없으면 학교 검색 결과 5건까지
NEIS_API_KEY=

# nginx(magonavi.milky.kr) → 127.0.0.1:8480. 프록시 뒤라 TRUST_PROXY=1 필수 (실제 IP·로그인 쿠키 Secure)
PORT=8480
HOST=127.0.0.1
TRUST_PROXY=1

# SQLite 위치 (서비스 계정만 쓸 수 있는 폴더)
DATA_DIR=/var/lib/mago-navi
