# .env로 복사해서 채운다 (.env는 git에 올리지 않음)

# AI: OpenAI 호환 Chat Completions 주소 (/chat/completions 빼고)
# 관리 화면 AI 연결에서 고른 연결이 있으면 그쪽을 씀
AI_BASE_URL=https://example.com/v1
AI_API_KEY=
AI_MODEL=
# 편제표 사진·PDF 읽기 모델 (이미지 입력 필요). 비우면 AI_MODEL
AI_VISION_MODEL=
# max_completion_tokens만 받는 모델
# AI_MAX_TOKENS_PARAM=max_completion_tokens
# response_format=json_object 지원 시 1
# AI_JSON_MODE=1
# 추론 강도. 모델마다 값이 다름 (예: Claude·GLM low, GPT·Qwen none). 비우면 안 보냄
# AI_REASONING_EFFORT=
# AI_VISION_REASONING_EFFORT=

# 관리 화면에서 넣은 API 키 암호화용 비밀값 (16자 이상)
# 비우면 DATA_DIR/ai-key.secret을 만들어 씀. 운영에서는 DB와 떨어진 여기가 안전
# 바꾸면 저장된 키를 못 풀어서 관리 화면에서 다시 넣어야 함
# AI_KEY_SECRET=

# 하루 전체 호출 상한 처음 값 (기본: 문장 검색 3000, 파일 읽기 300, 편제표 자동 읽기 200). 켠 뒤에는 관리 화면 설정에서
# DAILY_LIMIT_MATCH=3000
# DAILY_LIMIT_IMPORT=300
# DAILY_LIMIT_READ=200
# 대학 원문 변경을 AI로 찾는 하루 횟수
# DAILY_LIMIT_DATA=30

# SQLite(gwamok.db) 위치
DATA_DIR=./data

# 로그인: 마고에듀 통합 클라우드 계정으로만 (통합 클라우드 > 프로그램 관리 > mago-navi 를 켜고 주소를 이 서버로, '앱 비밀값 만들기')
# 통합 클라우드 주소 (끝 / 없이). 둘 다 있어야 로그인을 씀
MAGO_CLOUD_URL=https://mago.milky.kr
MAGO_APP_SECRET=
# 통합 클라우드 프로그램 ID (기본 mago-navi)
# MAGO_APP_ID=mago-navi
# 학원 AI·내 키가 모두 없을 때 위의 운영자 AI(AI_BASE_URL 등)로 넘길지 (비용 때문에 기본 끔)
# MAGO_SERVER_AI_FALLBACK=1
# 통합 클라우드 운영자(admin) 계정이 이 서버의 대표 관리자예요. 클라우드 로그인 토큰도 AI_KEY_SECRET 으로 암호화해 둬요.

# 스크립트로 편제표를 숨길 때 쓰는 토큰 (16자 이상). 비우면 이 API 꺼짐
# POST /api/admin/hide  Authorization: Bearer <토큰>  {"id": 번호}
ADMIN_TOKEN=

# 나이스 교육정보 개방 포털 인증키. 없으면 학교 검색 결과 5건까지
NEIS_API_KEY=

# 운영 서버
PORT=8080
HOST=127.0.0.1
# nginx 등 프록시 뒤일 때만 1 (X-Forwarded-For·Proto를 믿음). 운영(magonavi.milky.kr)에서는 꼭 1
# nginx에 proxy_set_header X-Forwarded-Proto $scheme; 가 있어야 로그인 쿠키에 __Host-·Secure가 붙음
# (mago·magonavi 는 같은 사이트라 SameSite 만으로는 다른 하위 도메인이 심은 쿠키를 막지 못함)
TRUST_PROXY=0
# 프록시가 X-Forwarded-Proto를 안 넘기는데 HTTPS만 쓰면 1
# COOKIE_SECURE=1
# 다른 주소에서 API를 부를 때만 (쉼표로 구분)
# ALLOWED_ORIGINS=https://example.com
